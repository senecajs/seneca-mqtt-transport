{
  "name": "@seneca/mqtt-transport",
  "version": "2.0.0",
  "main": "dist/MqttTransport.js",
  "type": "commonjs",
  "types": "dist/MqttTransport.d.ts",
  "description": "MQTT transport for Seneca messages, beneficial for IoT applications.",
  "homepage": "https://github.com/senecajs/seneca-mqtt-transport",
  "keywords": [
    "seneca",
    "transport",
    "mqtt",
    "mqtt-transport"
  ],
  "author": "Richard Rodger - richardrodger.com",
  "contributors": [
    "Leonardo Cunha https://github.com/lmscunha"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senecajs/seneca-mqtt-transport.git"
  },
  "scripts": {
    "prettier": "prettier --write .",
    "test": "npm run build && jest --coverage",
    "test-some": "jest -t",
    "test-watch": "jest --coverage --watchAll",
    "watch": "tsc -w -d",
    "build": "tsc -d",
    "doc": "seneca-doc",
    "clean": "rm -rf node_modules yarn.lock package-lock.json dist",
    "reset": "npm run clean && npm i && npm run build && npm test && npm run doc",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down -v"
  },
  "license": "MIT",
  "files": [
    "dist",
    "src/**/*.ts",
    "README.md",
    "CHANGES.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@seneca/doc": "^9.0.0",
    "@seneca/transport": "^9.0.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^24.0.0",
    "esbuild": "^0.19.12",
    "esbuild-jest": "^0.5.0",
    "jest": "^29.7.0",
    "prettier": "3.2.4",
    "seneca": "^4.0.0",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "seneca": "^4.0.0"
  },
  "dependencies": {
    "mqtt": "^5.3.5"
  }
}
